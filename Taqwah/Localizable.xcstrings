    "If you have questions about this Privacy Policy, please contact us through the Support page.": {
      "comment": "A description of how to contact support if you have questions about the privacy policy.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас есть вопросы по этой Политике конфиденциальности, свяжитесь с нами через страницу Поддержки."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы Құпиялылық саясаты бойынша сұрақтарыңыз болса, Қолдау бетінен бізбен байланысыңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushbu Maxfiylik siyosati bo'yicha savollaringiz bo'lsa, Qo'llab-quvvatlash sahifasi orqali biz bilan bog'laning."
          }
        }
      }
    },
